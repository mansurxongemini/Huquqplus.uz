# ============================================================
# HuquqPlus Bot - Namunaviy Konfiguratsiya Fayli (.env.example)
# ============================================================

# Loyiha ma'lumotlari
PROJECT_NAME="HuquqPlus Bot"
STACK_NAME=huquqplus-bot
DOMAIN=localhost

# Muhit turi: 'local', 'staging', yoki 'production'
# Diqqat: 'local' rejimda barcha guruhlar avtomatik LAWYER_APPOINTMENT_GROUP_ID ga yo'naltiriladi
ENVIRONMENT=local

# Webhook xavfsizligi uchun maxfiy kalit (tasodifiy 32 belgili matn)
SECRET_KEY=your_random_secret_key_here_32_chars

# Telegram Bot sozlamalari (@BotFather dan olinadi)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_NAME=your_bot_username
# Webhook URL (Ngrok yoki haqiqiy HTTPS domen, oxirida / qo'yilmaydi)
BOT_WEBHOOK_URL=https://your-domain-or-ngrok.ngrok-free.app

# Asosiy Telegram guruh ID lari
# Yurist qabuli guruh ID si (majburiy)
LAWYER_APPOINTMENT_GROUP_ID="-1001234567890"

# Admin Telegram ID lari (/admin paneli uchun, vergul bilan bir nechta yozish mumkin)
ADMIN_IDS="123456789,987654321"

# Texnik yordam so'rovlari guruhi (ixtiyoriy, berilmasa LAWYER_APPOINTMENT_GROUP_ID ishlatiladi)
HELP_GROUP_ID=

# Celery orqali haftalik/oylik hisobotlar yuboriladigan foydalanuvchi/guruh (masalan, @username yoki -100...)
# Ixtiyoriy: bo'sh qolsa localda LAWYER_APPOINTMENT_GROUP_ID ga boradi
REPORT_RECIPIENT=

# Murojaat yo'nalishlari bo'yicha Telegram guruh ID lari (ixtiyoriy)
# Eslatma: ENVIRONMENT=local bo'lsa va bu yer bo'sh qoldirilsa, barcha murojaatlar
# avtomatik ravishda LAWYER_APPOINTMENT_GROUP_ID dagi bitta test guruhiga tushadi!
GROUP_IJTIMOIY_HIMOYA=
GROUP_TALIM=
GROUP_MEHNAT=
GROUP_UY_JOY=
GROUP_TIBBIY=
GROUP_BOSHQA=

# Redis sozlamalari (Docker Compose da host: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=change_this_redis_password
REDIS_DB=0
REDIS_QUEUE_DB=1

# MariaDB (MySQL) sozlamalari (Docker Compose da host: mariadb)
DB_USER=huquqplus_user
DB_PASSWORD=change_this_db_password
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=huquqplus_db
MYSQL_ROOT_PASSWORD=change_this_root_password
MAX_WORKERS=1
